# Server secrets: copy to .env.local for local API testing, or add to Vercel Environment Variables.
# Never add NEXT_PUBLIC_ to either secret. Never put these values in GitHub or the app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Generate a separate private test code: openssl rand -hex 32
BRICKMADE_ACCESS_TOKEN=
# Origins, without paths. On Vercel include your exact production app origin.
# For example: https://brickmade.vercel.app,https://blockionaire.github.io
# For local work add your frontend's exact origin.
BRICKMADE_ALLOWED_ORIGINS=https://blockionaire.github.io,http://127.0.0.1:3000

# Category-first studio: server-only variables for the Next.js app and durable worker.
SUPABASE_URL=
# Either publishable key or legacy SUPABASE_ANON_KEY; no NEXT_PUBLIC_ variable needed.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BRICKMADE_APP_ORIGIN=https://brickmade.vercel.app
# Worker only. Copy the OpenAI secret directly into that host's environment too.
OPENAI_REASONING_EFFORT=high
# Worker only: the image model that draws the orthographic reference views, and its quality.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
# Optional server-side build-help model; defaults to OPENAI_MODEL.
# OPENAI_ASSISTANT_MODEL=gpt-5.2
# Local isolated Supabase CLI fixture only; never enable this on hosted production.
# BRICKMADE_LOCAL_SUPABASE=1
