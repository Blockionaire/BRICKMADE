# Server secrets: copy to .env.local for local API testing, or add to Vercel Environment Variables.
# Never add NEXT_PUBLIC_ to either secret. Never put these values in GitHub or the app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
# Generate a separate private test code: openssl rand -hex 32
BRICKMADE_ACCESS_TOKEN=
# Origins, without paths. For local work add your frontend's exact origin.
BRICKMADE_ALLOWED_ORIGINS=https://blockionaire.github.io,http://127.0.0.1:3000
